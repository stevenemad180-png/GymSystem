
@model IEnumerable<Plan>

@{
    ViewData["Title"] = "Plans";
}

<!-- ==================== PAGE CONTENT: /Plan/Index ==================== -->

<main class="content">

    <div class="page-head">
        <div>
            <h1 class="page-title">Plans</h1>
            <p class="page-sub">What members can subscribe to</p>
        </div>
    </div>

    <div class="callout" style="margin-bottom:22px">
        <i class="bi bi-shield-check"></i>

        <div>
            A plan with <strong>active or upcoming memberships</strong>
            is locked: it can't be edited or deactivated until those
            memberships end. Inactive plans can't be sold or edited.
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card-r empty" style="margin-top:22px">

            <div class="empty-icon">
                <i class="bi bi-tags"></i>
            </div>

            <h3>No plans found</h3>

        </div>
    }
    else
    {
        <div class="grid-cards">

            <!-- BACKEND: ONE card per plan -->

            @foreach (var plan in Model)
            {
                <div class="card-r plan-card">

                    <div style="display:flex;justify-content:space-between;align-items:center;gap:10px">

                        <!-- BACKEND: Plan Name -->
                        <h2 class="plan-name">@plan.Name</h2>

                        <!-- BACKEND: Active / Inactive Badge -->
                        <span class="badge-r @(plan.IsActive ? "badge-ok" : "badge-mute")">
                            @(plan.IsActive ? "Active" : "Inactive")
                        </span>

                    </div>

                    <!-- BACKEND: Price -->
                    <div class="plan-price">
                        @plan.Price<small>EGP</small>
                    </div>

                    <!-- BACKEND: DurationDays -->
                    <div class="plan-meta">
                        <i class="bi bi-calendar-range"></i>
                        @plan.DurationDays
                    </div>

                    <!-- BACKEND: Description -->
                    <p class="plan-desc">
                        Full gym floor access during staffed hours.
                    </p>

                    <div class="card-foot">

                        @if (plan.IsActive)
                        {
                            <!-- BACKEND: Edit page for this plan -->

                            <a class="btn-r btn-outline-r btn-sm-r"
                               asp-controller="Plan"
                               asp-action="Edit"
                               asp-route-id="@plan.Id">

                                <i class="bi bi-pencil"></i> Edit

                            </a>

                            <!-- BACKEND: Deactivate Plan -->

                            <form action="#"
                                  method="post"
                                  style="flex:1;display:flex"
                                  data-confirm="Deactivate Basic Monthly? It won't be available for new memberships.">

                                <button type="submit"
                                        class="btn-r btn-soft-danger btn-sm-r"
                                        style="flex:1">

                                    <i class="bi bi-pause-circle"></i>
                                    Deactivate

                                </button>

                            </form>
                        }
                        else
                        {
                            <!-- BACKEND: Activate Plan -->

                            <form action="#"
                                  method="post"
                                  style="flex:1;display:flex"
                                  data-confirm="Activate Basic Monthly? It will be available for new memberships.">

                                <button type="submit"
                                        class="btn-r btn-soft-ok btn-sm-r"
                                        style="flex:1">

                                    <i class="bi bi-play-circle"></i>
                                    Activate

                                </button>

                            </form>
                        }

                    </div>

                </div>
            }

        </div>
    }

</main>

<!-- ================== END PAGE CONTENT ================== -->
